# ---- generated dependency checkouts, toolchains and build products ----
# scripts/setup.sh keeps these outside the repository by default
# (~/inf2004-deps); ignore them here too in case someone points --deps inside.
/deps/
/inf2004-deps/
/build-target/
firmware/build-host/
firmware/build-apphost/
firmware/validation/local/
firmware/validation/ci/
robot_build_evidence/

# Firmware images are CI artifacts or local build products, never committed.
# Old images must not be mistaken for the current revision.
*.uf2
*.elf
*.map
*.o
*.d
*.su
*.a
# Project-template build state and the host-built UF2 converter.
build_make/.build_profile
build_make/tools/elf2uf2
tools/elf2uf2/elf2uf2

# ---- real credentials and local configuration (keep the .example.h files) ----
# config/wifi_credentials.h and config/net_mqtt_config.h hold the robot's
# network settings; config/wifi_secrets.h is the template's own equivalent.
wifi_credentials.h
net_mqtt_config.h
wifi_secrets.h
!net_mqtt_config.example.h
!wifi_credentials.example.h
.env
*.env
*.pem
*.key
*.p12
secrets.*

# Videos are shared as unlisted YouTube links (videos/README.md), never committed.
*.mp4
*.mov
*.webm
*.avi
*.mkv

# ---- tooling noise ----
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
venv/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
~$*.docx
